{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EraseCord",
  "mainBinaryName": "erasecord-app",
  "version": "0.2.0",
  "identifier": "dev.erasecord.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "EraseCord",
        "width": 1040,
        "height": 740,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: https://cdn.discordapp.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "publisher": "EraseCord",
    "homepage": "https://github.com/Rn11/erasecord",
    "category": "Utility",
    "shortDescription": "Delete your own Discord messages",
    "longDescription": "EraseCord deletes your own Discord messages from the servers and direct messages you choose, within a time range you choose.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
